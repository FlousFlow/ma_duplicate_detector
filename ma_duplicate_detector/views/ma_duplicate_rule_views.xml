<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ma_duplicate_rule_form" model="ir.ui.view">
        <field name="name">ma.duplicate.rule.form</field>
        <field name="model">ma.duplicate.rule</field>
        <field name="arch" type="xml">
            <form string="Duplicate Rule">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="field_ids"
                               widget="many2many_tags"
                               domain="[('model_id', '=', model_id),
                                        ('store', '=', True),
                                        ('ttype', 'not in', ['one2many', 'many2many', 'binary'])]"
                               options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ma_duplicate_rule_list" model="ir.ui.view">
        <field name="name">ma.duplicate.rule.list</field>
        <field name="model">ma.duplicate.rule</field>
        <field name="arch" type="xml">
            <list string="Duplicate Rules" create="1">
                <field name="name" string="Model"/>
                <field name="field_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ma_duplicate_rule" model="ir.actions.act_window">
        <field name="name">Duplicate Rules</field>
        <field name="res_model">ma.duplicate.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
